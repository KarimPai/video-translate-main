
"""Rolling-window pyannote speaker diarization."""

import logging
import os
import queue
import threading

import numpy as np

from .types import SAMPLE_RATE

log = logging.getLogger(__name__)

WINDOW_S = 10
HOP_S = 6
MIN_TAIL_S = 2

WINDOW = WINDOW_S * SAMPLE_RATE
HOP = HOP_S * SAMPLE_RATE
MIN_TAIL = MIN_TAIL_S * SAMPLE_RATE


class PyannoteDiarizer:
    def __init__(self, device="cuda", max_speakers=3):
        import torch
        from pyannote.audio import Pipeline

        token = os.getenv("HF_TOKEN") or os.getenv("HUGGINGFACE_HUB_TOKEN")
        if not token:
            raise RuntimeError("HF_TOKEN environment variable is missing")

        self.torch = torch
        self.max_speakers = max(1, int(max_speakers))

        if device.startswith("cuda") and not torch.cuda.is_available():
            log.warning("CUDA unavailable; using CPU for pyannote")
            device = "cpu"

        self.device = device

        self.pipeline = Pipeline.from_pretrained(
            "pyannote/speaker-diarization-community-1",
            token=token,
        )

        self.pipeline.to(torch.device(device))

        if device.startswith("cuda"):
            self.pipeline.segmentation_batch_size = 4
            self.pipeline.embedding_batch_size = 4
            log.info(
                "pyannote batch sizes: segmentation=4, embedding=4"
            )

        self.condition = threading.Condition()
        self.segments = []
        self.processed_until = 0.0
        self.finished = False
        self.failed = False
        self.known_speakers = set()

        log.info("pyannote Community-1 loaded on %s", device)

    def _diarize(self, audio, start_sample):
        waveform = self.torch.from_numpy(
            np.asarray(audio, dtype=np.float32).copy()
        ).unsqueeze(0)

        with self.torch.inference_mode():
            result = self.pipeline(
                {
                    "waveform": waveform,
                    "sample_rate": SAMPLE_RATE,
                },
                max_speakers=self.max_speakers,
            )

        annotation = result.exclusive_speaker_diarization

        start_s = start_sample / SAMPLE_RATE

        return [
            (
                start_s + turn.start,
                start_s + turn.end,
                str(speaker),
            )
            for turn, _, speaker in annotation.itertracks(yield_label=True)
        ]

    def _map_speakers(self, current, previous, overlap_start, overlap_end):
        scores = {}

        for old_start, old_end, old_id in previous:
            for new_start, new_end, new_id in current:
                overlap = max(
                    0.0,
                    min(old_end, new_end, overlap_end)
                    - max(old_start, new_start, overlap_start),
                )

                if overlap:
                    key = (old_id, new_id)
                    scores[key] = scores.get(key, 0.0) + overlap

        mapping = {}
        used_old = set()
        used_new = set()

        for (old_id, new_id), score in sorted(
            scores.items(), key=lambda item: item[1], reverse=True
        ):
            if old_id not in used_old and new_id not in used_new:
                mapping[new_id] = old_id
                used_old.add(old_id)
                used_new.add(new_id)

        labels = sorted({segment[2] for segment in current})

        for label in labels:
            if label in mapping:
                continue

            if len(self.known_speakers) < self.max_speakers:
                new_id = f"Speaker {len(self.known_speakers) + 1}"
                self.known_speakers.add(new_id)
                mapping[label] = new_id
            else:
                candidates = [
                    (score, old_id)
                    for (old_id, new_id), score in scores.items()
                    if new_id == label
                ]

                if candidates:
                    mapping[label] = max(candidates)[1]
                elif self.known_speakers:
                    mapping[label] = sorted(self.known_speakers)[0]

        return [
            (start, end, mapping[speaker])
            for start, end, speaker in current
            if speaker in mapping
        ]

    def _commit(self, segments, commit_start, commit_end):
        with self.condition:
            for start, end, speaker in segments:
                start = max(start, commit_start)
                end = min(end, commit_end)

                if end > start:
                    self.segments.append((start, end, speaker))

            self.processed_until = commit_end
            self.condition.notify_all()

    def run(self, in_q):
        buffer = np.empty(0, dtype=np.float32)
        buffer_start = None
        previous_end = None
        previous_segments = []

        try:
            while True:
                chunk = in_q.get()

                if chunk is None:
                    break

                if chunk.reset:
                    buffer = np.empty(0, dtype=np.float32)
                    buffer_start = chunk.start_sample
                    previous_end = None
                    previous_segments = []

                    with self.condition:
                        self.segments.clear()
                        self.known_speakers.clear()
                        self.processed_until = chunk.start_sample / SAMPLE_RATE
                        self.condition.notify_all()

                    continue

                if not chunk.pcm.size:
                    continue

                if buffer_start is None:
                    buffer_start = chunk.start_sample

                expected = buffer_start + len(buffer)

                if chunk.start_sample != expected:
                    buffer = np.empty(0, dtype=np.float32)
                    buffer_start = chunk.start_sample
                    previous_end = None
                    previous_segments = []

                buffer = np.concatenate((buffer, chunk.pcm))

                while len(buffer) >= WINDOW:
                    audio = buffer[:WINDOW]
                    window_start = buffer_start
                    window_end = window_start + WINDOW

                    current = self._diarize(audio, window_start)

                    commit_start = (
                        previous_end if previous_end is not None
                        else window_start
                    )

                    mapped = self._map_speakers(
                        current,
                        previous_segments,
                        window_start / SAMPLE_RATE,
                        commit_start / SAMPLE_RATE,
                    )

                    self._commit(
                        mapped,
                        commit_start / SAMPLE_RATE,
                        window_end / SAMPLE_RATE,
                    )

                    previous_segments = mapped
                    previous_end = window_end

                    buffer = buffer[HOP:]
                    buffer_start += HOP

            # Process the final partial window.
            if len(buffer) >= MIN_TAIL:
                current = self._diarize(buffer, buffer_start)

                commit_start = (
                    previous_end if previous_end is not None
                    else buffer_start
                )

                mapped = self._map_speakers(
                    current,
                    previous_segments,
                    buffer_start / SAMPLE_RATE,
                    commit_start / SAMPLE_RATE,
                )

                self._commit(
                    mapped,
                    commit_start / SAMPLE_RATE,
                    (buffer_start + len(buffer)) / SAMPLE_RATE,
                )

        except Exception:
            log.exception("pyannote diarization failed")
            self.failed = True

        finally:
            with self.condition:
                self.finished = True
                self.condition.notify_all()

    def identify(self, start_s, end_s):
        with self.condition:
            while end_s > self.processed_until and not self.finished:
                self.condition.wait()

            if self.failed:
                return ""

            best_speaker = ""
            best_overlap = 0.0

            for start, end, speaker in self.segments:
                overlap = max(
                    0.0,
                    min(end, end_s) - max(start, start_s),
                )

                if overlap > best_overlap:
                    best_overlap = overlap
                    best_speaker = speaker

            return best_speaker
